{
  "name": "toolshop-playwright-bdd",
  "version": "0.1.0",
  "description": "Cucumber-style (Gherkin) UI + API test automation for Practice Software Testing (Toolshop) using Playwright, playwright-bdd and Allure.",
  "keywords": [
    "playwright",
    "bdd",
    "cucumber",
    "gherkin",
    "allure",
    "api-testing",
    "test-automation"
  ],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:smoke": "bddgen && playwright test --grep @smoke --project=chromium",
    "test:chromium": "bddgen && playwright test --project=chromium",
    "test:firefox": "bddgen && playwright test --project=firefox",
    "test:webkit": "bddgen && playwright test --project=webkit",
    "test:headed": "bddgen && playwright test --headed --project=chromium",
    "docker:build": "docker compose build tests",
    "docker:test": "docker compose run --rm tests sh -c \"npx bddgen && npx playwright test\"",
    "docker:smoke": "docker compose run --rm tests sh -c \"npx bddgen && npx playwright test --grep @smoke --project=chromium\"",
    "docker:visual:update": "docker compose run --rm tests sh -c \"npx bddgen && npx playwright test --project=chromium --grep @visual --update-snapshots\"",
    "docker:shell": "docker compose run --rm tests bash",
    "export:testcases": "node scripts/export-test-cases.js",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "report:html": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure": "^3.22.1",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "exceljs": "^4.4.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10"
  }
}
